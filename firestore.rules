rules_version = '2';

// ===============================================================
// Assumed Data Model & Architecture Overview
// ===============================================================
//
// Root Collections (Platform Scope):
//
// 1. businesses/{businessId}
//    - Primary multi-tenant tenant boundary document.
//    - Fields:
//      * businessName: string (optional, 1-150 chars)
//      * name: string (optional, 1-100 chars) - Owner display name
//      * email: string (optional, <= 128 chars)
//      * mobile: string (optional, <= 32 chars)
//      * role: string (required) - 'SHOP_OWNER', 'EMPLOYEE', etc. Protected from escalation.
//      * firebaseUid: string (optional) - Linked Firebase Auth UID
//      * ownerId: string (optional legacy owner UID)
//      * accountStatus: string (optional) - 'Active', 'PendingApproval', 'Suspended'
//      * plan: string (optional)
//      * ecommerce: map (subdomain, published status)
//      * createdAt: string / timestamp (optional, immutable)
//      * updatedAt: string / timestamp (optional)
//
// 2. businesses/{businessId}/{subcollection}/{docId}
//    - Multi-tenant tenant-scoped documents (48 subcollections):
//      products, transactions, entities, staff, warehouses, financialAccounts,
//      onlineOrders, quotations, kitchenOrders, kitchenTickets, kitchenSettings,
//      purchaseOrders, stockTransfers, giftCards, bankStatements, journalEntries,
//      ledgerEntries, leaveRequests, payrollRuns, rawMaterials, boms,
//      productionBatches, departments, designations, workShifts, holidays,
//      backups, settings, catalogCategories, catalogBrands, wastage,
//      lettersOfCredit, loans, hotelRooms, hotelReservations, providentFund,
//      eprocurement, vehicles, vehicleLogs, visitors, projects,
//      projectTasks, dealerTargets, documentAiJobs, notifications,
//      supportTickets, feedbacks, marketingCampaigns, customerGroups.
//    - Fields:
//      * id: string (optional, immutable)
//      * business_id: string (optional, immutable, must match businessId)
//      * businessId: string (optional, immutable, must match businessId)
//      * createdAt: string / timestamp (optional, immutable)
//      * updatedAt: string / timestamp (optional)
//
// 3. Sensitive Financial & Transaction Collections:
//    - journalEntries, transactions, ledgerEntries:
//      Direct client-side writes strictly DENIED (write: if false).
//      All financial journal postings, reversals, and POS transactions MUST
//      flow through backend Express API endpoints utilizing the Firebase Admin SDK.
//
// 4. Public Storefront Catalog:
//    - Public catalog requests MUST route through backend Express API
//      (/api/storefront/:slug/catalog), which enforces safe data projection
//      (stripping purchasePrice, supplierId, BOM, lot registers, and internal notes).
//
// 5. Standalone Root Platform Collections:
//    - globalCustomers, platformConfig, saasTickets, announcements, backups,
//      saasAdmins, saasOwnerConfig, saasAlerts, auditLogs, revenuePayments,
//      mrrSnapshots, users (legacy).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Safety Net: Default Deny All Access
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions: Authentication, Roles & Tenant Isolation
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSaasOwner() {
      return isAuthenticated() &&
             'role' in request.auth.token &&
             request.auth.token.role == 'SAAS_OWNER';
    }

    function isSaasAdmin() {
      return isAuthenticated() &&
             'role' in request.auth.token &&
             request.auth.token.role == 'SAAS_ADMIN';
    }

    function isSaasStaff() {
      return isAuthenticated() &&
             'role' in request.auth.token &&
             (request.auth.token.role == 'SAAS_OWNER' || request.auth.token.role == 'SAAS_ADMIN');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.:@-]+$');
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
             (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function isTenantMember(businessId) {
      return isAuthenticated() && (
        request.auth.uid == businessId ||
        ('businessId' in request.auth.token && request.auth.token.businessId == businessId) ||
        ('business_id' in request.auth.token && request.auth.token.business_id == businessId)
      );
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() && (
        request.auth.uid == businessId ||
        ('businessId' in request.auth.token && request.auth.token.businessId == businessId) ||
        ('business_id' in request.auth.token && request.auth.token.business_id == businessId) ||
        (resource != null && 'firebaseUid' in resource.data && resource.data.firebaseUid == request.auth.uid) ||
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid)
      );
    }

    function isAllowedTenantSubcollection(subcollection) {
      return subcollection in [
        'products', 'entities', 'staff', 'warehouses',
        'financialAccounts', 'onlineOrders', 'quotations', 'kitchenOrders',
        'kitchenTickets', 'kitchenSettings', 'purchaseOrders', 'stockTransfers',
        'giftCards', 'bankStatements', 'leaveRequests',
        'payrollRuns', 'rawMaterials', 'boms', 'productionBatches',
        'departments', 'designations', 'workShifts', 'holidays', 'backups',
        'settings', 'catalogCategories', 'catalogBrands', 'wastage',
        'lettersOfCredit', 'loans', 'hotelRooms', 'hotelReservations',
        'providentFund', 'eprocurement', 'vehicles', 'vehicleLogs',
        'visitors', 'projects', 'projectTasks', 'dealerTargets',
        'documentAiJobs', 'notifications', 'supportTickets', 'feedbacks',
        'marketingCampaigns', 'customerGroups'
      ];
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidBusinessData(data) {
      return isValidOptionalString(data, 'businessName', 1, 150) &&
             isValidOptionalString(data, 'name', 1, 100) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 32)) &&
             (!('firebaseUid' in data) || (data.firebaseUid is string && data.firebaseUid.size() <= 128)) &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128));
    }

    function isValidBusinessCreate(data) {
      return isValidBusinessData(data) &&
             (!('role' in data) || data.role in ['SHOP_OWNER', 'EMPLOYEE'] || isSaasStaff()) &&
             (!('accountStatus' in data) || data.accountStatus in ['Active', 'PendingApproval', 'Suspended'] || isSaasStaff());
    }

    function isValidBusinessUpdate(data) {
      return isValidBusinessData(data) &&
             // Prevent privilege escalation: non-SaaS staff cannot grant themselves SAAS roles
             (!('role' in data) || (resource != null && data.role == resource.data.role) || isSaasStaff()) &&
             // Protect immutable creation timestamp and owner UID linkage
             (!('createdAt' in resource.data) || !('createdAt' in data) || data.createdAt == resource.data.createdAt) &&
             (!('firebaseUid' in resource.data) || !('firebaseUid' in data) || data.firebaseUid == resource.data.firebaseUid);
    }

    function isValidProductData(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 200)) &&
             (!('salePrice' in data) || (data.salePrice is number && data.salePrice >= 0)) &&
             (!('purchasePrice' in data) || (data.purchasePrice is number && data.purchasePrice >= 0)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 20)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 50));
    }

    function isValidStaffData(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 32)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             (!('firebaseUid' in data) || (data.firebaseUid is string && data.firebaseUid.size() <= 128)) &&
             (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 100));
    }

    function isValidSubcollectionDoc(businessId, docId, subcollection, data) {
      return isValidId(docId) &&
             // Tenant containment: document payload cannot reference a foreign tenant
             (!('business_id' in data) || data.business_id == businessId) &&
             (!('businessId' in data) || data.businessId == businessId) &&
             // Subcollection-specific schema bounding
             (subcollection != 'products' || isValidProductData(data)) &&
             (subcollection != 'staff' || isValidStaffData(data));
    }

    function areTenantImmutableFieldsUnchanged() {
      return (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
             (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id) &&
             (!('business_id' in resource.data) || !('business_id' in request.resource.data) || request.resource.data.business_id == resource.data.business_id) &&
             (!('businessId' in resource.data) || !('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.businessId);
    }

    function isValidTicketData(data) {
      return isValidOptionalString(data, 'subject', 1, 200) &&
             isValidOptionalString(data, 'message', 1, 5000) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 30));
    }

    function isValidCustomerData(data) {
      return isValidOptionalString(data, 'name', 1, 100) &&
             isValidOptionalString(data, 'email', 1, 100) &&
             isValidOptionalString(data, 'phone', 1, 30);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Tenant Shop Account (businesses/{businessId})
    match /businesses/{businessId} {
      allow get: if isSaasStaff() || isBusinessOwner(businessId);
      allow list: if isSaasStaff();

      allow create: if isSaasStaff() || (
        isAuthenticated() &&
        (request.auth.uid == businessId || ('firebaseUid' in request.resource.data && request.resource.data.firebaseUid == request.auth.uid)) &&
        isValidBusinessCreate(request.resource.data)
      );

      allow update: if isSaasStaff() || (
        isBusinessOwner(businessId) &&
        isValidBusinessUpdate(request.resource.data)
      );

      allow delete: if isSaasOwner();

      // -------------------------------------------------------------
      // Financial Collections: Explicit Invariant Hardening
      // -------------------------------------------------------------

      // 1. Double-Entry Journal Entries (Financial Immutability & Authoritative Ledger)
      // Direct client creation, modification, or deletion is forbidden to prevent unverified ledger entries.
      // All journal entry writes must execute server-side through backend APIs via Admin SDK.
      match /journalEntries/{entryId} {
        allow read: if isTenantMember(businessId) || isSaasStaff();
        allow write: if false;
      }

      // 2. Sales & Inventory Transactions (Authoritative Stock Integrity)
      // Direct client mutation is forbidden to prevent negative inventory and offline tampering.
      // All mutations must execute server-side through backend Express API transactions.
      match /transactions/{transactionId} {
        allow read: if isTenantMember(businessId) || isSaasStaff();
        allow write: if false;
      }

      // 3. Legacy Ledger Entries (Financial Ledger Integrity)
      // Historical ledger records must remain immutable from client apps.
      match /ledgerEntries/{entryId} {
        allow read: if isTenantMember(businessId) || isSaasStaff();
        allow write: if false;
      }

      // Tenant-isolated subcollections: businesses/{businessId}/{subcollection}/{docId}
      match /{subcollection}/{docId} {
        allow read: if isAllowedTenantSubcollection(subcollection) &&
                       (isTenantMember(businessId) || isSaasStaff());

        allow create: if isAllowedTenantSubcollection(subcollection) &&
                        (isTenantMember(businessId) || isSaasStaff()) &&
                        isValidSubcollectionDoc(businessId, docId, subcollection, request.resource.data);

        allow update: if isAllowedTenantSubcollection(subcollection) &&
                        (isTenantMember(businessId) || isSaasStaff()) &&
                        isValidSubcollectionDoc(businessId, docId, subcollection, request.resource.data) &&
                        areTenantImmutableFieldsUnchanged();

        allow delete: if isAllowedTenantSubcollection(subcollection) &&
                        (isTenantMember(businessId) || isSaasStaff());
      }
    }

    // Standalone Root: /globalCustomers/{phone}
    match /globalCustomers/{phone} {
      function isCustomerOwner() {
        return isAuthenticated() && (
          request.auth.uid == phone ||
          ('phone_number' in request.auth.token && request.auth.token.phone_number == phone) ||
          ('phone' in request.auth.token && request.auth.token.phone == phone)
        );
      }

      allow read: if isSaasStaff() || isCustomerOwner();
      allow create: if (isSaasStaff() || isCustomerOwner()) && isValidCustomerData(request.resource.data);
      allow update: if (isSaasStaff() || isCustomerOwner()) && isValidCustomerData(request.resource.data) &&
                       (!('phone' in resource.data) || !('phone' in request.resource.data) || request.resource.data.phone == resource.data.phone);
      allow delete: if isSaasStaff();
    }

    // Standalone Root: /platformConfig/{configId}
    match /platformConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSaasStaff();
    }

    // Standalone Root: /saasTickets/{ticketId}
    match /saasTickets/{ticketId} {
      function isTicketTenant(data) {
        return isAuthenticated() && (
          ('businessId' in request.auth.token && (
            ('business_id' in data && data.business_id == request.auth.token.businessId) ||
            ('businessId' in data && data.businessId == request.auth.token.businessId)
          )) ||
          ('business_id' in data && data.business_id == request.auth.uid) ||
          ('businessId' in data && data.businessId == request.auth.uid)
        );
      }

      allow read: if isSaasStaff() || isTicketTenant(resource.data);
      allow create: if (isSaasStaff() || isTicketTenant(request.resource.data)) && isValidTicketData(request.resource.data);
      allow update: if isSaasStaff() || (
        isTicketTenant(resource.data) &&
        isValidTicketData(request.resource.data) &&
        (!('business_id' in resource.data) || !('business_id' in request.resource.data) || request.resource.data.business_id == resource.data.business_id) &&
        (!('businessId' in resource.data) || !('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.businessId)
      );
      allow delete: if isSaasStaff();
    }

    // Standalone Root: /announcements/{id}
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isSaasStaff();
    }

    // Standalone Root: /backups/{backupId}
    match /backups/{backupId} {
      allow read, write: if isSaasStaff();
    }

    // Standalone Root: /saasAdmins/{adminId}
    match /saasAdmins/{adminId} {
      allow read, write: if isSaasOwner();
    }

    // Standalone Root: /saasOwnerConfig/{configId}
    match /saasOwnerConfig/{configId} {
      allow read, write: if isSaasOwner();
    }

    // Platform Feeds: /saasAlerts, /auditLogs, /revenuePayments, /mrrSnapshots
    match /saasAlerts/{alertId} {
      allow read, write: if isSaasStaff();
    }

    match /auditLogs/{logId} {
      allow read: if isSaasStaff();
      allow write: if false; // Immutable audit log written only by backend admin SDK
    }

    match /revenuePayments/{paymentId} {
      allow read, write: if isSaasStaff();
    }

    match /mrrSnapshots/{snapshotId} {
      allow read, write: if isSaasStaff();
    }

    // Legacy Support: /users/{userId} (Strictly self-owned)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /{allChildren=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}
