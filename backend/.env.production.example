# =============================================================================
# Bizora API — PRODUCTION template
# Copy to backend/.env (or host secrets manager). Never commit real values.
# Checklist: docs/SECURITY_CHECK.md · docs/PRODUCTION.md
# Verify: GET /api/admin/readiness  (SaaS token)
# =============================================================================

NODE_ENV=production
PORT=3000

# --- Required secrets (generate before deploy) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=
OTP_DEV_ECHO=false
OTP_SKIP_COOLDOWN=0
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MS=900000
OTP_COOLDOWN_MS=60000

# bcrypt hash — node backend/scripts/generate-password-hash.mjs "YourStrongPassword"
SAAS_OWNER_EMAIL=owner@yourdomain.com
SAAS_OWNER_MOBILE=
SAAS_OWNER_NAME=Platform Owner
SAAS_OWNER_PASSWORD_HASH=

# --- Public URLs (no trailing slash) ---
APP_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
CORS_ORIGINS=

# --- Firebase Admin ---
# FIREBASE_SERVICE_ACCOUNT_PATH=/secure/serviceAccount.json
# OR one-line JSON:
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- OTP delivery (at least one channel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=Bizora <noreply@yourdomain.com>

# --- Backups ---
BACKUP_AT_REST_KEY=

# --- Payments (optional until go-live) ---
PAYMENT_DEFAULT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=https://api.yourdomain.com/api/payments/webhook/bkash

# --- Login-As ---
IMPERSONATE_TTL=15m
IMPERSONATE_READ_ONLY=1
