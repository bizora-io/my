# =============================================================================
# PRODUCTION: set NODE_ENV=production, a long random JWT_SECRET (not the sample),
# OTP_DEV_ECHO=false, OTP_SKIP_COOLDOWN=0, real Firebase + Twilio/Resend.
# Full checklist: docs/PRODUCTION.md — verify with GET /api/admin/readiness
# =============================================================================

# Server port
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=your_super_secret_jwt_key_here

# SaaS Owner (platform super-admin) - never hardcode this in frontend code.
# Generate the hash with: node backend/scripts/generate-password-hash.mjs "your password"
SAAS_OWNER_EMAIL=
SAAS_OWNER_MOBILE=
SAAS_OWNER_NAME=
SAAS_OWNER_PASSWORD_HASH=

# Firebase Admin SDK (server-side) - paste the full service account JSON as
# one line, OR set GOOGLE_APPLICATION_CREDENTIALS to a key file path instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS - allowed origins in production
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- OTP / transactional messaging (production) ---
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Bizora <onboarding@resend.dev>

# Local testing: return OTP in API JSON (never enable in production)
OTP_DEV_ECHO=false

# OTP hardening
OTP_PEPPER=change-me-to-a-long-random-string
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MS=900000

# --- Payment gateways ---
PAYMENT_DEFAULT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:3000/api/payments/webhook/bkash

# 32-byte hex or any secret string (SHA-256 derived) for cloud backup at-rest encryption
BACKUP_AT_REST_KEY=

# Firebase (pick one)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# OTP: set OTP_DEV_ECHO=1 to return code in API response (never in production)

# OTP cooldown: dev default 15s. Set OTP_SKIP_COOLDOWN=1 to disable in non-production.
OTP_COOLDOWN_MS=15000
OTP_SKIP_COOLDOWN=0


# --- Login-As (SaaS support impersonation) ---
IMPERSONATE_TTL=15m
# Set to 1 in production support policy for full read-only Login-As
IMPERSONATE_READ_ONLY=0


# --- Couriers (optional — keys also storable per-business in Admin/Shop settings) ---
# Status callbacks: GET /api/couriers/webhook-info (auth) for per-business URLs
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# REDX_API_KEY=
